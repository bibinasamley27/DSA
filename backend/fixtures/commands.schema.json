          "type": "string"
        },
        "kind": {
          "const": "command",
          "title": "Kind",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "command": {
          "const": "set_controller",
          "title": "Command",
          "type": "string"
        },
